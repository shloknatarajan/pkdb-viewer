{"schema_version":1,"snapshot":"2021-12-03","source":{"repository":"matthiaskoenig/pkdb_analysis","path":"tests/data/testdata_concise_false.zip","url":"https://raw.githubusercontent.com/matthiaskoenig/pkdb_analysis/develop/tests/data/testdata_concise_false.zip"},"sid":"PKDB00028","namespace":"pkdb","name":"Iqbal1995","licence":"closed","access":"public","date":"2019-05-07","creator":"jbrandhorst","curators":["jbrandhorst","mkoenig"],"substances":["paracetamol","caffeine (137X)"],"identifiers":{"source_study_sid":"PKDB00028","pmid":"7579030","pmcid":null,"doi":null,"pkdb_sid":"PKDB00028"},"reference":{"title":"The effect of caffeine on the pharmacokinetics of acetaminophen in man.","date":"1995-12-19","journal":"Biopharmaceutics & drug disposition","authors":["N Iqbal","B Ahmad","K H Janbaz","A U Gilani","S K Niazi"],"abstract":"The influence of caffeine (60 mg) was studied on the pharmacokinetic characteristics of acetaminophen (500 mg single dose) in ten healthy male human volunteers in a complete cross-over design. A high-performance liquid chromatography (HPLC) method was used to analyse serum drug concentrations. Caffeine caused a highly significant (p < 0.01) increase in AUC and AUMC, a significant (p < 0.05) increase in Cmax, and a significant (p < 0.05) decrease in clearance (C1/F) of acetaminophen. We conclude that caffeine taken in doses commonly available commercially or in a cup of coffee can significantly potentiate the therapeutic potential of acetaminophen in man."},"row_counts":{"groups":7,"individuals":0,"interventions":2,"outputs":81,"timecourses":2,"scatters":0},"entity_counts":{"groups":1,"individuals":0,"interventions":2,"outputs":54,"timecourses":2,"scatters":0},"groups":[{"study_name":"Iqbal1995","measurement_type":"species","group_count":"10","group_name":"all","max":null,"substance":null,"count":10,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":148,"charact