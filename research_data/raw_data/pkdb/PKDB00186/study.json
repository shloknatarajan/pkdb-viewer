{"schema_version":1,"snapshot":"2021-12-03","source":{"repository":"matthiaskoenig/pkdb_analysis","path":"tests/data/testdata_concise_false.zip","url":"https://raw.githubusercontent.com/matthiaskoenig/pkdb_analysis/develop/tests/data/testdata_concise_false.zip"},"sid":"PKDB00186","namespace":"pkdb","name":"Clements1976","licence":"closed","access":"public","date":"2019-09-30","creator":"jbrandhorst","curators":["mkoenig","jbrandhorst"],"substances":["paracetamol"],"identifiers":{"source_study_sid":"PKDB00186","pmid":"10395","pmcid":null,"doi":null,"pkdb_sid":"PKDB00186"},"reference":{"title":"Data point weighting in pharmacokinetic analysis: intravenous paracetamol in man.","date":"1976-12-30","journal":"The Journal of pharmacy and pharmacology","authors":["J A Clements","L F Prescott"],"abstract":"Compartmental analysis of plasma paracetamol concentrations following intravenous injection of 12 mg kg-1 in aqueous solution to normal subjects was performed using analogue and digital computer methods. Using a \"simplex\" non-linear optimization procedure, the pharmacokinetic parameters were found to be influenced considerably by the choice of the weighting factors (W1) attributed to individual data points. The plasma half-life of paracetamol varied by up to a seven-fold with the weighting factors selected. However, the predicted mean steady-state plasma concentrations were shown to be relatively little affected by the different weighting factors."},"row_counts":{"groups":6,"individuals":24,"interventions":1,"outputs":8,"timecourses":0,"scatters":0},"entity_counts":{"groups":1,"individuals":4,"interventions":1,"outputs":8,"timecourses":0,"scatters":0},"groups":[{"study_name":"Clements1976","measurement_type":"overnight fast","group_count":"4","group_name":"all","max":null,"substance":null,"count":4,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":48,"characteristica_pk":592,"mean":null,