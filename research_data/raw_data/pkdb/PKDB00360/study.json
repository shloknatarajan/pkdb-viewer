{"schema_version":1,"snapshot":"2021-12-03","source":{"repository":"matthiaskoenig/pkdb_analysis","path":"tests/data/testdata_concise_false.zip","url":"https://raw.githubusercontent.com/matthiaskoenig/pkdb_analysis/develop/tests/data/testdata_concise_false.zip"},"sid":"PKDB00360","namespace":"pkdb","name":"Marino2000","licence":"closed","access":"public","date":"2020-10-24","creator":"FlorBar","curators":["FlorBar","mkoenig"],"substances":["simvastatin","simvastatin acid","irbesartan"],"identifiers":{"source_study_sid":"PKDB00360","pmid":"10934672","pmcid":null,"doi":null,"pkdb_sid":"PKDB00360"},"reference":{"title":"Irbesartan does not affect the pharmacokinetics of simvastatin in healthy subjects.","date":"2000-11-30","journal":"Journal of clinical pharmacology","authors":["M R Marino","N N Vachharajani","O W Hadjilambris"],"abstract":"This open-label, single-dose, crossover study was conducted to assess the effect of irbesartan on the pharmacokinetics of total simvastatin acid in 14 healthy subjects. Subjects were randomized to receive one simvastatin 40 mg tablet or one simvastatin 40 mg tablet + one irbesartan 300 mg tablet. Subjects were crossed over to the other treatment after a 7- to 10-day washout period. Serum samples were collected at specified times before and over a 24-hour period after dosing. Safety was assessed by monitoring vital signs, laboratory tests, and adverse events. Irbesartan did not exhibit a clinically significant effect on the peak serum concentration and area under the concentration versus time curve to infinity (AUC0-infinity) of total simvastatin acid. The mean AUC0-infinity of total simvastatin acid was 74.55 ng x h/mL when simvastatin was given alone and 67.55 ng x h/mL when simvastatin and irbesartan were given concomitantly. The time to peak serum concentration for both treatments was 3 hours. No serious adverse events occurred during the study, and both agents were well tolerated. In summary, irbesartan had no significant effect on the single-dose pharmacokinetics of total simvastatin acid."},"row_counts":{"groups":23,"individuals":0,"interventions":2,"outputs":42,"timecourses":2,"scatters":0},"entity_counts":{"groups":2,"individuals":0,"interventions":2,"outputs":28,"timecourses":2,"scatters":0},"groups":[{"study_name":"Marino2000","measurement_type":"species","group_count":"14","group_name":"all","max":null,"substance":null,"count":14,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":2081,"characteristica_pk":43493,"mean":null,"choice":"homo sapiens","value":null},{"study_name":"Marino2000","measurement_type":"healthy","group_count":"14","group_name":"all","max":null,"substance":null,"count":14,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":2081,"characteristica_pk":43494,"mean":null,"choice":"Y","value":null},{"study_name":"Marino2000","measurement_type":"medication","group_count":"14","group_name":"all","max":null,"substance":null,"count":14,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":2081,"characteristica_pk":43495,"mean":null,"choice":"N","value":null},{"study_name":"Marino2000","measurement_type":"sex","group_count":"14","group_name":"all","max":null,"substance":null,"count":13,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":2081,"characteristica_pk":43496,"mean":null,"choice":"M","value":null},{"study_name":"Marino2000","measurement_type":"sex","group_count":"14","group_name":"all","max":null,"substance":null,"count":1,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":2081,"characteristica_pk":43497,"mean":null,"choice":"F","value":null},{"study_name":"Marino