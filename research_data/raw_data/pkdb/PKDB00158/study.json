{"schema_version":1,"snapshot":"2021-12-03","source":{"repository":"matthiaskoenig/pkdb_analysis","path":"tests/data/testdata_concise_false.zip","url":"https://raw.githubusercontent.com/matthiaskoenig/pkdb_analysis/develop/tests/data/testdata_concise_false.zip"},"sid":"PKDB00158","namespace":"pkdb","name":"Mitchell1983","licence":"closed","access":"public","date":"2019-07-28","creator":"jbrandhorst","curators":["mkoenig","jbrandhorst"],"substances":["paracetamol","paracetamol glucuronide","paracetamol sulfate","paracetamol cysteine","paracetamol mercapturate"],"identifiers":{"source_study_sid":"PKDB00158","pmid":"6861437","pmcid":null,"doi":null,"pkdb_sid":"PKDB00158"},"reference":{"title":"Effects of oral contraceptive steroids on acetaminophen metabolism and elimination.","date":"1983-08-11","journal":"Clinical pharmacology and therapeutics","authors":["M C Mitchell","T Hanew","C G Meredith","S Schenker"],"abstract":"Plasma acetaminophen elimination was examined in women taking low-dose oral contraceptives (OCs) and in age-matched control women.  Fractional rates of elimination and fractional clearances were calculated for each of the metabolic pathways, including oxidation, sulfation, and glucuronidation.  The cysteine adduct and mercapturic acid derivative of acetaminophen were used as an index of oxidative biotransformation, a potentially toxic route of metabolism for acetaminophen.  Plasma acetaminophen clearance rose from 287 +or- 13 ml/minute to 470 +or- 51 ml/minute in women taking OCs, whereas elimination t1/2 decreased from 2.40 +or- 0.14 hours to 1.67 +or- 0.16 hours.  The fractional clearance and rate of elimination of acetaminophen by glucuronidation increased in women taking OCs, whereas the clearance and elimination by sulfation did not differ significantly from values in control subjects.  Fractional clearance of the cysteine adduct also increased significantly, but clearance of acetaminophen mercapturic acid did not change.  These data suggest that the increased clearance of acetaminophen from plasma in women taking OCs results from increased glucuronidation of the drug, although the mechanism is not known."},"row_counts":{"groups":17,"individuals":0,"interventions":1,"outputs":55,"timecourses":2,"scatters":0},"entity_counts":{"groups":3,"individuals":0,"interventions":1,"outputs":55,"timecourses":2,"scatters":0},"groups":[{"study_name":"Mitchell1983","measurement_type":"species","group_count":"14","group_name":"all","max":null,"substance":null,"count":14,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":380,"characteristica_pk":7160,"mean":null,"choice":"homo sapiens","value":null},{"study_name":"Mitchell1983","measurement_type":"sex","group_count":"14","group_name":"all","max":null,"substance":null,"count":14,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":380,"characteristica_pk":7161,"mean":null,"choice":"F","value":null},{"study_name":"Mitchell1983","measurement_type":"healthy","group_count":"14","group_name":"all","max":null,"substance":null,"count":14,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":380,"characteristica_pk":7162,"mean":null,"choice":"Y","value":null},{"study_name":"Mitchell1983","measurement_type":"age","group_count":"14","group_name":"all","max":34,"substance":null,"count":14,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":"year","se":null,"min":21,"cv":null,"median":null,"group_pk":380,"characteristica_pk":7163,"mean":null,"choice":null,"value":null},{"study_name":"Mitchell1983","measurement_type":"overnight fast","group_count":"14","group_name":"all","max":null,"substance":null,"count":14,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":nul