{"schema_version":1,"snapshot":"2021-12-03","source":{"repository":"matthiaskoenig/pkdb_analysis","path":"tests/data/testdata_concise_false.zip","url":"https://raw.githubusercontent.com/matthiaskoenig/pkdb_analysis/develop/tests/data/testdata_concise_false.zip"},"sid":"PKDB00435","namespace":"pkdb","name":"Becker1984","licence":"closed","access":"public","date":"2021-07-08","creator":"adriankl","curators":["adriankl","mkoenig"],"substances":["theophylline (13X)","caffeine (137X)"],"identifiers":{"source_study_sid":"PKDB00435","pmid":"6700656","pmcid":null,"doi":null,"pkdb_sid":"PKDB00435"},"reference":{"title":"The bronchodilator effects and pharmacokinetics of caffeine in asthma.","date":"1984-04-06","journal":"The New England journal of medicine","authors":["A B Becker","K J Simons","C A Gillespie","F E Simons"],"abstract":"We compared the bronchodilator effects and pharmacokinetics of orally administered caffeine (10 mg per kilogram of body weight) and theophylline (5 mg per kilogram) in a double-blind, single-dose study in asthmatic patients 8 to 18 years of age. After 48 hours of withdrawal of all methylxanthines, 13 patients received caffeine and 10 received theophylline. Significant improvements in forced vital capacity, forced expiratory volume in one second, and forced expiratory flow rates occurred from one to six hours after administration of either caffeine or theophylline. The bronchodilator effect of caffeine did not differ significantly from that of theophylline and was maximal two hours after ingestion of each drug. Peak serum levels of caffeine (13.5 +/- 2.9 mg per liter) occurred at one hour, and peak levels of theophylline (8.4 +/- 1.7 mg per liter) at 2.2 +/- 0.8 hours. The mean serum half-time for caffeine was 3.9 +/- 1.4 hours and that for theophylline was 5.8 +/- 1.7 hours. All patients receiving caffeine metabolized it to paraxanthine, theobromine, and theophylline. Mild, transient side effects were seen after both caffeine and theophylline. Vital signs did not change significantly after either drug. We conclude that caffeine, a commonly available chemical, is an effective bronchodilator in young patients with asthma."},"row_counts":{"groups":21,"individuals":0,"interventions":2,"outputs":42,"timecourses":2,"scatters":0},"entity_counts":{"groups":3,"individuals":0,"interventions":2,"outputs":42,"timecourses":2,"scatters":0},"groups":[{"study_name":"Becker1984","measurement_type":"age","group_count":"23","group_name":"all","max":18,"substance":null,"count":23,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":"year","se":null,"min":8,"cv":null,"median":null,"group_pk":3052,"characteristica_pk":87040,"mean":null,"choice":null,"value":null},{"study_name":"Becker1984","measurement_type":"species","group_count":"23","group_name":"all","max":null,"substance":null,"count":23,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":3052,"characteristica_pk":87034,"mean":null,"choice":"homo sapiens","value":null},{"study_name":"Becker1984","measurement_type":"fasting","group_count":"23","group_name":"all","max":null,"substance":null,"count":23,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":3052,"characteristica_pk":87035,"mean":null,"choice":"Y","value":null},{"study_name":"Becker1984","measurement_type":"healthy","group_count":"23","group_name":"all","max":null,"substance":null,"count":23,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":3052,"characteristica_pk":87036,"mean":null,"choice":"N","value":null},{"study_name":"Becker1984","measurement_type":"disease","group_count":"23","group_name":"all","max":null,"substance":null,"count":23,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"