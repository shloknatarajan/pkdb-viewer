{"schema_version":1,"snapshot":"2021-12-03","source":{"repository":"matthiaskoenig/pkdb_analysis","path":"tests/data/testdata_concise_false.zip","url":"https://raw.githubusercontent.com/matthiaskoenig/pkdb_analysis/develop/tests/data/testdata_concise_false.zip"},"sid":"1577043","namespace":"pmid","name":"Nielsen1992","licence":"closed","access":"public","date":"2021-07-13","creator":"jbrandhorst","curators":["jbrandhorst","mkoenig"],"substances":["paracetamol"],"identifiers":{"source_study_sid":"1577043","pmid":"1577043","pmcid":null,"doi":null,"pkdb_sid":null},"reference":{"title":"Analgesic efficacy of immediate and sustained release paracetamol and plasma concentration of paracetamol. Double blind, placebo-controlled evaluation using painful laser stimulation.","date":"1992-06-11","journal":"European journal of clinical pharmacology","authors":["J C Nielsen","P Bjerring","L Arendt-Nielsen","K J Petterson"],"abstract":"The analgesic efficacy of single doses of immediate release paracetamol 500 mg and 1000 mg, sustained release paracetamol 2000 mg, and placebo was evaluated over a 12 h period in 10 healthy volunteers. The efficacy was related to the concurrent plasma concentrations of paracetamol. Experimental pain was induced by brief cutaneous application of argon laser pulses, and the analgesic effect was assessed as change in pricking pain threshold. Both 0.5 g and 1.0 g immediate release paracetamol had an analgesic effect superior to that of placebo from 1 to 5 h after administration. Peak analgesia was reached after 2 h. No difference was found in the analgesic effect of the two dosages. Sustained release paracetamol was not significantly superior to placebo at any time. The plasma concentration of paracetamol had peaked in the 1 h sample after of the immediate release tablet. The peak plasma concentration was reached 3-4 h after 2.0 g sustained release paracetamol. It is not known why the sustained release formulation did not produce any detectable analgesia. It is proposed, that the rate of increase in the plasma concentration of paracetamol might be important in the alleviation of acute (laser-induced) pain."},"row_counts":{"groups":8,"individuals":0,"interventions":3,"outputs":57,"timecourses":3,"scatters":0},"entity_counts":{"groups":1,"individuals":0,"interventions":3,"outputs":57,"timecourses":3,"scatters":0},"groups":[{"study_name":"Nielsen1992","measurement_type":"healthy","group_count":"10","group_name":"all","max":null,"substance":null,"count":10,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":215,"characteristica_pk":4608,"mean":null,"choice":"Y","value":null},{"study_name":"Nielsen1992","measurement_type":"age","group_count":"10","group_name":"all","max":50,"substance":null,"count":10,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":"year","se":null,"min":25,"cv":null,"median":null,"group_pk":215,"characteristica_pk":4609,"mean":32,"choice":null,"value":null},{"study_name":"Nielsen1992","measurement_type":"weight","group_count":"10","group_name":"all","max":85,"substance":null,"count":10,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":"kilogram","se":null,"min":57,"cv":null,"median":null,"group_pk":215,"characteristica_pk":4610,"mean":70,"choice":null,"value":null},{"study_name":"Nielsen1992","measurement_type":"height","group_count":"10","group_name":"all","max":1.94,"substance":null,"count":10,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":"meter","se":null,"min":1.67,"cv":null,"median":null,"group_pk":215,"characteristica_pk":4611,"mean":1.8,"choice":null,"value":null},{"study_name":"Nielsen1992","measurement_type":"overnight fast","group_count":"10","group_name":"all","max":null,"substance":null,"count":10,"calculation_type":"sample mean","group_parent_pk":null,"sd":null,"unit":null,"se":null,"min":null,"cv":null,"median":null,"group_pk":215,"c